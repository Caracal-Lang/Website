// We can tell the compiler to step by 10 for each member, unless we give a value
// The default step is 1 without the step annotation
#step(10)
enum BuildStage : i32
{
    Lexer               // 0
    Parser              // 10
    Typechecker :: 50   // 50
    Optimizer           // 60
}

// A flag enum gives each member the next power of two value
#flag
enum Permission : i32
{
    Read                // 1
    Write               // 2
    Execute             // 4
}

def main() i32
{
    stage :: BuildStage.Typechecker;
    permission :: Permission.Write;

    return 1 if stage == BuildStage.Optimizer;
    return 2 if permission == Permission.Write;
    return 0;
}
