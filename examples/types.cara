// Constructor parameters are specified on the type
type Vector2D(x: i32, y: i32)
{
    x := x
    y := y

    // we access fields with a leading dot, there is not "this" keyword
    def lengthSquared() i32
    {
        return (.x %* .x) %+ (.y %* .y);
    }

    // Static methods start with the type name
    def Vector2D.zero() Vector2D
    {
        return Vector2D.new(0, 0);
    }
}

def main() i32
{
    point := Vector2D.new(3, 4);
    return point.lengthSquared();
}
